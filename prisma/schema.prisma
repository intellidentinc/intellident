generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

// UserRole is stored as Int: 1=ADMIN, 2=DENTIST, 3=RECEPTIONIST, 4=PATIENT

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  RESCHEDULED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum RecordStatus {
  ACTIVE
  ARCHIVED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  REFUNDED
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum NotificationType {
  BOOKING_REQUEST
  APPOINTMENT_CONFIRMED
  APPOINTMENT_CANCELLED
  APPOINTMENT_COMPLETED
  APPOINTMENT_NO_SHOW
  APPOINTMENT_RESCHEDULED
  REMINDER_24H
  REMINDER_2H
  PAYMENT_RECEIVED
}

enum AuditAction {
  LOGIN
  LOGIN_FAILED
  LOGOUT
  CREATE
  UPDATE
  DELETE
  VIEW
  EXPORT
  VERIFY
  AI_INTERACTION
  LOCKOUT
  BREACH_ALERT
  BACKUP
  RESTORE
}

enum ChatRole {
  USER
  ASSISTANT
}

enum ConsentStatus {
  PENDING
  GIVEN
  REVOKED
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DataRequestType {
  ACCESS
  CORRECTION
  DELETION
}

enum DataRequestStatus {
  PENDING
  IN_REVIEW
  RESOLVED
  REJECTED
}

// ─── Models ───────────────────────────────────────────────────────────────────

model Clinic {
  id        String    @id @default(cuid())
  name      String
  code      String?
  address   String?
  phone     String?
  landline  String?
  logoUrl   String?
  email     String?
  reservationFeeAmount  Float   @default(0)
  paymongoEnabled       Boolean @default(false)
  passwordExpiryEnabled Boolean @default(false)
  singleSessionEnabled  Boolean @default(false)
  notifConfig           Json?
  reminder1Hours        Int     @default(24)
  reminder2Hours        Int     @default(2)
  auditLogRetentionDays         Int?
  patientRecordRetentionDays    Int?
  billingRetentionDays          Int?
  isEnabled Boolean   @default(true)
  isDeleted Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  users            User[]
  receptionists    Receptionist[]
  dentists         Dentist[]
  patients         Patient[]
  services         Service[]
  appointments     Appointment[]
  auditLogs        AuditLog[]
  schedule         ClinicSchedule?
  closures         ClinicClosure[]
  schedulePresets  SchedulePreset[]
  chatSessions     ChatSession[]
  applications     ClinicApplication[]
  dataRequests     DataRequest[]

  @@map("clinics")
}

model ClinicSchedule {
  id          String   @id @default(cuid())
  clinicId    String   @unique
  workingDays String[] @default([])
  openTime    String   @default("08:00")
  closeTime   String   @default("17:00")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id])

  @@map("clinic_schedules")
}

model ClinicClosure {
  id        String   @id @default(cuid())
  clinicId  String
  date      DateTime
  reason    String?
  createdAt DateTime @default(now())

  clinic Clinic @relation(fields: [clinicId], references: [id])

  @@index([clinicId])
  @@map("clinic_closures")
}

model SchedulePreset {
  id          String    @id @default(cuid())
  clinicId    String
  name        String
  workingDays String[]
  openTime    String
  closeTime   String
  isDeleted   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  clinic Clinic @relation(fields: [clinicId], references: [id])

  @@index([clinicId])
  @@map("schedule_presets")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
  @@map("password_reset_tokens")
}

model EmailVerification {
  id         String   @id @default(cuid())
  token         String   @unique
  email         String
  firstName     String?
  middleInitial String?
  lastName      String?
  phone      String?
  address    String?
  dateOfBirth DateTime?
  password   String
  wrappedKey String
  keySalt    String
  clinicId   String?
  termsAcceptedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([email])
  @@map("email_verifications")
}

model ClinicApplication {
  id                 String            @id @default(cuid())
  clinicName         String
  businessAddress    String
  businessPhone      String
  businessEmail      String
  contactPersonName  String
  contactPersonPhone String
  contactPersonEmail String?
  birDocuments       String[]          @default([])
  applicantIds       String[]          @default([])
  message            String?
  status             ApplicationStatus @default(PENDING)
  notes              String?
  clinicId           String?
  termsAcceptedAt    DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  clinic Clinic? @relation(fields: [clinicId], references: [id])

  @@index([status])
  @@map("clinic_applications")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  firstName     String?
  middleInitial String?
  lastName      String?
  phone       String?
  address     String?
  dateOfBirth DateTime?
  gender      Gender?
  password        String
  passwordHistory String[] @default([])
  role            Int       @default(4)
  wrappedKey String?
  keySalt    String?
  clinicId            String?
  failedLoginAttempts Int       @default(0)
  lastFailedAt        DateTime?
  lockedUntil         DateTime?
  isDeleted             Boolean   @default(false)
  isActive              Boolean   @default(true)
  username              String?   @unique
  mustChangePassword    Boolean   @default(false)
  passwordExpiresAt     DateTime?
  termsAcceptedAt       DateTime?
  createdAt             DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  clinic                  Clinic?                    @relation(fields: [clinicId], references: [id])
  patient                 Patient?
  receptionist            Receptionist?
  dentist                 Dentist?
  auditLogs               AuditLog[]
  appointmentStatusChanges AppointmentStatusHistory[]
  inAppNotifications      InAppNotification[]
  mfaOtps                 MfaOtp[]
  chatSessions            ChatSession[]
  dataRequests            DataRequest[]
  recordHistories         RecordHistory[]
  sessions                UserSession[]
  knownDevices            KnownDevice[]

  @@index([clinicId])
  @@map("users")
}

model Patient {
  id              String        @id @default(cuid())
  userId          String        @unique
  clinicId        String
  patientCode     String?       @unique
  firstName       String
  lastName        String
  dateOfBirth     DateTime?
  gender          Gender?
  phone           String?
  address         String?
  consentStatus   ConsentStatus @default(PENDING)
  consentGivenAt  DateTime?
  isDeleted       Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  user          User            @relation(fields: [userId], references: [id])
  clinic        Clinic          @relation(fields: [clinicId], references: [id])
  appointments  Appointment[]
  records       PatientRecord[]
  billings      Billing[]
  notifications Notification[]

  @@index([clinicId])
  @@map("patients")
}

model Receptionist {
  id        String    @id @default(cuid())
  userId    String    @unique
  clinicId  String
  isDeleted Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user   User   @relation(fields: [userId], references: [id])
  clinic Clinic @relation(fields: [clinicId], references: [id])

  @@index([clinicId])
  @@map("receptionists")
}

model Dentist {
  id        String    @id @default(cuid())
  userId    String    @unique
  clinicId  String
  specialty String?
  isDeleted Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user         User          @relation(fields: [userId], references: [id])
  clinic       Clinic        @relation(fields: [clinicId], references: [id])
  appointments Appointment[]
  services     Service[]     @relation("ServiceDentists")

  @@index([clinicId])
  @@map("dentists")
}

model Service {
  id          String    @id @default(cuid())
  clinicId    String
  name        String
  description String?
  duration    Int       // minutes
  price       Float?
  bufferTime  Int       @default(0) // minutes (0–30)
  isDeleted   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  clinic              Clinic               @relation(fields: [clinicId], references: [id])
  appointments        Appointment[]
  appointmentServices AppointmentService[]
  dentists            Dentist[]            @relation("ServiceDentists")

  @@index([clinicId])
  @@map("services")
}

model Appointment {
  id              String            @id @default(cuid())
  clinicId        String
  patientId       String
  dentistId       String?
  serviceId       String?
  appointmentCode String?           @unique
  scheduledAt     DateTime
  endsAt          DateTime
  status          AppointmentStatus @default(PENDING)
  notes           String?
  aiSuggested     Boolean           @default(false)
  reminderSent24h Boolean           @default(false)
  reminderSent2h  Boolean           @default(false)
  isDeleted       Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?

  clinic        Clinic                       @relation(fields: [clinicId], references: [id])
  patient       Patient                      @relation(fields: [patientId], references: [id])
  dentist       Dentist?                     @relation(fields: [dentistId], references: [id])
  service       Service?                     @relation(fields: [serviceId], references: [id])
  services      AppointmentService[]
  billing            Billing?
  notifications      Notification[]
  inAppNotifications InAppNotification[]
  statusHistory      AppointmentStatusHistory[]

  @@index([clinicId])
  @@index([patientId])
  @@index([dentistId])
  @@index([scheduledAt])
  @@index([clinicId, status])
  @@index([clinicId, scheduledAt])
  @@index([reminderSent24h, reminderSent2h, scheduledAt])
  @@map("appointments")
}

model AppointmentService {
  appointmentId String
  serviceId     String
  order         Int    @default(0)

  appointment Appointment @relation(fields: [appointmentId], references: [id])
  service     Service     @relation(fields: [serviceId], references: [id])

  @@id([appointmentId, serviceId])
  @@index([serviceId])
  @@map("appointment_services")
}

model AppointmentStatusHistory {
  id            String            @id @default(cuid())
  appointmentId String
  status        AppointmentStatus
  changedById   String?
  changedAt     DateTime          @default(now())
  note          String?

  appointment Appointment @relation(fields: [appointmentId], references: [id])
  changedBy   User?       @relation(fields: [changedById], references: [id])

  @@index([appointmentId])
  @@map("appointment_status_history")
}

model PatientRecord {
  id            String       @id @default(cuid())
  patientId     String
  clinicId      String
  title         String
  encryptedData String?      // AES-GCM encrypted blob (client-side E2EE)
  dataIv        String?      // IV for decryption
  contentHash   String?      // SHA-256 hash for tamper detection
  status        RecordStatus @default(ACTIVE)
  isDeleted     Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?

  patient     Patient       @relation(fields: [patientId], references: [id])
  attachments Attachment[]
  history     RecordHistory[]

  @@index([patientId])
  @@index([clinicId])
  @@map("patient_records")
}

model Attachment {
  id        String    @id @default(cuid())
  recordId  String
  fileName  String
  fileUrl   String
  mimeType  String
  isDeleted Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  record PatientRecord @relation(fields: [recordId], references: [id])

  @@index([recordId])
  @@map("attachments")
}

model Billing {
  id            String        @id @default(cuid())
  clinicId      String
  patientId     String
  appointmentId String        @unique
  amount        Float
  amountPaid    Float         @default(0)
  balance       Float
  status        PaymentStatus @default(UNPAID)
  receiptNumber String?       @unique
  isDeleted     Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  patient     Patient     @relation(fields: [patientId], references: [id])
  appointment Appointment @relation(fields: [appointmentId], references: [id])
  payments    Payment[]

  @@index([clinicId])
  @@index([patientId])
  @@index([status])
  @@map("billings")
}

model Payment {
  id                        String    @id @default(cuid())
  billingId                 String
  amount                    Float
  method                    String?
  notes                     String?
  type                      String    @default("FULL") // "RESERVATION" | "FULL" | "PARTIAL"
  paymongoCheckoutSessionId String?
  paymongoPaymentId         String?
  paidAt                    DateTime  @default(now())
  isDeleted                 Boolean   @default(false)
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  deletedAt                 DateTime?

  billing Billing @relation(fields: [billingId], references: [id])

  @@index([billingId])
  @@map("payments")
}

model Notification {
  id            String             @id @default(cuid())
  clinicId      String
  patientId     String
  appointmentId String?
  status        NotificationStatus @default(PENDING)
  subject       String?
  message       String
  scheduledAt   DateTime?
  sentAt        DateTime?
  isDeleted     Boolean            @default(false)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  deletedAt     DateTime?

  patient     Patient      @relation(fields: [patientId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])

  @@index([patientId])
  @@index([clinicId])
  @@map("notifications")
}

model InAppNotification {
  id            String           @id @default(cuid())
  userId        String
  clinicId      String
  type          NotificationType
  title         String
  body          String
  appointmentId String?
  isRead        Boolean          @default(false)
  createdAt     DateTime         @default(now())

  user        User         @relation(fields: [userId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])

  @@index([userId, isRead])
  @@index([clinicId])
  @@map("in_app_notifications")
}

model MfaOtp {
  id           String    @id @default(cuid())
  userId       String
  pendingToken String    @unique
  codeHash     String
  rememberMe   Boolean   @default(false)
  attempts     Int       @default(0)
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("mfa_otps")
}

model AuditLog {
  id        String      @id @default(cuid())
  userId    String?
  clinicId  String?
  action    AuditAction
  entity    String      // e.g. "Appointment", "PatientRecord"
  entityId  String?
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime    @default(now())

  user   User?   @relation(fields: [userId], references: [id])
  clinic Clinic? @relation(fields: [clinicId], references: [id])

  @@index([userId])
  @@index([clinicId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model ChatSession {
  id        String    @id @default(cuid())
  userId    String
  clinicId  String
  title     String?
  isDeleted Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user     User          @relation(fields: [userId], references: [id])
  clinic   Clinic        @relation(fields: [clinicId], references: [id])
  messages ChatMessage[]

  @@index([userId])
  @@index([clinicId])
  @@map("chat_sessions")
}

model ChatMessage {
  id        String   @id @default(cuid())
  sessionId String
  role      ChatRole
  content   String   @db.Text
  createdAt DateTime @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id])

  @@index([sessionId])
  @@map("chat_messages")
}

model RateLimit {
  id        Int      @id @default(autoincrement())
  key       String
  count     Int      @default(1)
  windowEnd DateTime

  @@index([key])
  @@index([windowEnd])
  @@map("rate_limits")
}

model DataRequest {
  id          String            @id @default(cuid())
  userId      String
  clinicId    String
  type        DataRequestType
  status      DataRequestStatus @default(PENDING)
  description String?
  adminNotes  String?
  resolvedAt  DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  clinic Clinic @relation(fields: [clinicId], references: [id])

  @@index([clinicId, status])
  @@index([userId])
  @@map("data_requests")
}

model RecordHistory {
  id        String   @id @default(cuid())
  recordId  String
  userId    String
  diff      Json
  createdAt DateTime @default(now())

  record PatientRecord @relation(fields: [recordId], references: [id])
  user   User          @relation(fields: [userId], references: [id])

  @@index([recordId])
  @@map("record_history")
}

model UserSession {
  id           String    @id @default(cuid())
  userId       String
  clinicId     String?
  sessionToken String    @unique
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  terminatedAt DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("user_sessions")
}

model KnownDevice {
  id            String   @id @default(cuid())
  userId        String
  userAgentHash String
  lastIp        String?
  firstSeenAt   DateTime @default(now())
  lastSeenAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, userAgentHash])
  @@index([userId])
  @@map("known_devices")
}
